modules = ["dart-3.12", "nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["flutter", "chromium", "glib", "gtk3", "nss", "atk", "cups", "pango", "libdrm", "mesa", "libglvnd", "xorg.libX11", "xorg.libxcb", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXrandr", "xorg.libXi", "xorg.libXtst", "shellcheck"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-flutter-preview.sh"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 18145
externalPort = 3001

[[ports]]
localPort = 20986
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
publicDir = "deploy/public"
build = ["bash", "-c", "cd flutter_app && flutter pub get && flutter build web --release --no-tree-shake-icons && cd ../server && npm ci"]
run = ["bash", "-c", "cd server && PORT=5000 exec node bin/start.js"]

[userenv]

[userenv.shared]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

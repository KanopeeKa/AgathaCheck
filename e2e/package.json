{
  "name": "agatha-track-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright BDD/E2E tests for Agatha Track (Flutter web + Node API)",
  "scripts": {
    "test": "playwright test --project=full",
    "test:shard": "playwright test --shard",
    "test:ci-shard": "node scripts/run-ci-shard.mjs",
    "shard:plan": "node scripts/shard-files.mjs --summary",
    "test:smoke-ci": "playwright test --project=ci-canary",
    "test:smoke-uat": "playwright test --project=uat-smoke --max-failures=1",
    "test:smoke": "npm run test:smoke-uat",
    "test:warmup-uat": "playwright test --project=warmup-uat --max-failures=1",
    "test:live-uat-gate": "playwright test --project=warmup-uat --project=uat-smoke --max-failures=1",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium --with-deps",
    "test:unit": "tsc -p tsconfig.unit.json && node --test dist/unit/*.test.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}

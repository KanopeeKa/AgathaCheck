{
  "name": "agatha-track-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright BDD/E2E tests for Agatha Track (Flutter web + Node API)",
  "scripts": {
    "test": "playwright test",
    "test:shard": "playwright test --shard",
    "test:ci-shard": "node scripts/run-ci-shard.mjs",
    "shard:plan": "node scripts/shard-files.mjs --summary",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}

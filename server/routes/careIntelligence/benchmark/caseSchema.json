{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agathatrack://care-intelligence/benchmark-case/v1",
  "title": "Care Intelligence benchmark case (D6.0)",
  "type": "object",
  "required": ["caseId", "species", "measurements", "expectedReviewRelevance"],
  "additionalProperties": false,
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "species": { "enum": ["cat", "dog"] },
    "provenance": { "type": "string" },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "weight", "unit", "measurement_source"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "enum": ["kg", "lb"] },
          "measurement_source": {
            "enum": ["guardian", "clinic", "device", "imported"]
          }
        }
      }
    },
    "weightContext": {
      "type": "object",
      "properties": {
        "reference_value": { "type": ["number", "null"] },
        "reference_authority": {
          "enum": [
            "vet_target",
            "guardian_reference",
            "historical_baseline",
            null
          ]
        },
        "management_context": {
          "enum": ["none", "vet_managed", "care_plan", "treatment_related"]
        }
      }
    },
    "expectedReviewRelevance": {
      "enum": [
        "relevant",
        "not_relevant",
        "uncertain",
        "uncertain/reviewer_disagreement"
      ]
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewerDecision", "reviewerConfidence", "reviewerRationale"],
        "properties": {
          "reviewerId": { "type": "string" },
          "reviewerDecision": {
            "enum": ["relevant", "not_relevant", "uncertain"]
          },
          "reviewerConfidence": { "enum": ["low", "medium", "high"] },
          "reviewerRationale": { "type": "string" }
        }
      }
    },
    "adjudicatedLabel": {
      "enum": ["relevant", "not_relevant", "uncertain", "uncertain/reviewer_disagreement"]
    },
    "adjudicationReason": { "type": "string" },
    "disagreementFlag": { "type": "boolean" },
    "hindsightRules": { "type": "string" },
    "notes": { "type": "string" }
  }
}

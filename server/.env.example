# PostgreSQL Connection Configuration
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_db_name

# Authentication
# Required in production — the server refuses to start without it.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Server Configuration
PORT=3000
NODE_ENV=development

# Public app URL (email links and footers; no trailing slash)
APP_PUBLIC_URL=https://uat.agathatrack.com

# Password reset email (required on UAT/production when NODE_ENV=production)
# o2switch: use your-server.o2switch.net, port 465, secure=true
UAT_SMTP_HOST=your-server.o2switch.net
UAT_SMTP_PORT=465
UAT_SMTP_SECURE=true
UAT_MAIL_USER=noreply@uat.agathatrack.com
UAT_MAIL_PASS=your-email-account-password
UAT_MAIL_FROM=Agatha Track <noreply@uat.agathatrack.com>

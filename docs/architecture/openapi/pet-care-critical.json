{
  "openapi": "3.1.0",
  "info": {
    "title": "Agatha Track — Pet Care critical API subset",
    "version": "1.0.0",
    "description": "Stable DTO contract for pets CRUD, lifecycle, and auth session tokens (F-14). Mounted at /api and /backend/api."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/auth/signup": {
      "post": {
        "operationId": "authSignup",
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "authLogin",
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "responses": {
          "200": {
            "description": "Tokens rotated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthTokenPair" }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "Owned pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "responses": {
          "201": {
            "description": "Pet created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/all": {
      "get": {
        "operationId": "listAllPets",
        "responses": {
          "200": {
            "description": "Owned, shared, foster, and org pets visible to user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "operationId": "getPet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet deleted (data cascade on server)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeletePetResponse" }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/data": {
      "delete": {
        "operationId": "deletePetData",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet-related rows and files removed; pet row retained until DELETE /pets/{id}",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PetDataDeleteResponse" }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/passed-away": {
      "post": {
        "operationId": "notifyPassedAway",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Collaborators notified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PassedAwayResponse" }
              }
            }
          }
        }
      }
    },
    "/health-entries/{id}": {
      "get": {
        "operationId": "getCareItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          }
        ],
        "responses": {
          "200": {
            "description": "Care item with open occurrences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareItem"
                }
              }
            }
          }
        }
      }
    },
    "/health-entries/{id}/occurrences/{occId}/complete": {
      "post": {
        "operationId": "completeOccurrence",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          },
          {
            "$ref": "#/components/parameters/OccurrenceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Completed; the next date is in entry.open_occurrences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Refused, nothing saved — e.g. next_choice_not_available when an explicit next_choice does not fit this completion (D-CSM-026)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareCommandError"
                }
              }
            }
          }
        }
      }
    },
    "/health-entries/{id}/occurrences/{occId}": {
      "get": {
        "operationId": "getOccurrence",
        "description": "One occurrence for the occurrence screen (§18.7.1). Same access as the occurrence list.",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          },
          {
            "$ref": "#/components/parameters/OccurrenceId"
          }
        ],
        "responses": {
          "200": {
            "description": "The occurrence, its care item summary, the item's latest undoable action, and the weight saved with it (weigh-ins)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrenceDetail"
                }
              }
            }
          },
          "404": {
            "description": "Care item or occurrence not found, or not on that care item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchOccurrence",
        "description": "Edit a completed occurrence: notes and provider, or completed_on on its own (D-CSM-034). A completed_on change runs as one undoable care command.",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          },
          {
            "$ref": "#/components/parameters/OccurrenceId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OccurrencePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated. With completed_on: the occurrence fields plus the care command response (moved_next_id, next_unchanged)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionDateResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_completed_on, completed_on_in_future, completed_on_before_start, completed_on_with_other_fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareCommandError"
                }
              }
            }
          },
          "404": {
            "description": "Care item or completed occurrence not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "occurrence_not_completed — only a completed occurrence can change when it was done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareCommandError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PetId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "HealthEntryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OccurrenceId": {
        "name": "occId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CalendarDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Calendar day on the wire (YYYY-MM-DD)"
      },
      "User": {
        "type": "object",
        "required": ["id", "email"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "category": { "type": "string" },
          "locale": { "type": "string" }
        }
      },
      "AuthTokenPair": {
        "type": "object",
        "required": ["access_token", "refresh_token"],
        "additionalProperties": false,
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["user", "access_token", "refresh_token"],
        "additionalProperties": false,
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "Pet": {
        "type": "object",
        "required": ["id", "name", "species"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "species": { "type": "string" },
          "breed": { "type": "string" },
          "age": { "type": ["number", "null"] },
          "dateOfBirth": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "date_of_birth": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "weight": { "type": ["number", "null"] },
          "gender": { "type": ["string", "null"] },
          "bio": { "type": "string" },
          "insurance": { "type": "string" },
          "neuteredDate": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "neuterDismissed": { "type": "boolean" },
          "chipId": { "type": "string" },
          "chipDismissed": { "type": "boolean" },
          "photoPath": { "type": ["string", "null"] },
          "vetId": { "type": ["string", "null"] },
          "colorValue": { "type": ["integer", "null"] },
          "passedAway": { "type": "boolean" },
          "organization_id": { "type": ["string", "null"], "format": "uuid" },
          "organization_name": { "type": ["string", "null"] },
          "is_shared": { "type": "boolean" },
          "is_foster": { "type": "boolean" },
          "foster_placement_status": { "type": ["string", "null"] },
          "foster_name": { "type": ["string", "null"] },
          "primary_holder_name": { "type": ["string", "null"], "description": "Deprecated alias for pet_parent_name" },
          "pet_parent_name": { "type": ["string", "null"] },
          "access_role": { "type": ["string", "null"], "enum": ["carer", "co_parent", null] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "DeletePetResponse": {
        "type": "object",
        "required": ["deleted"],
        "additionalProperties": false,
        "properties": {
          "deleted": { "type": "boolean", "const": true }
        }
      },
      "PetDataDeleteResponse": {
        "type": "object",
        "required": ["deleted", "pet_id", "rows_removed", "files_removed"],
        "additionalProperties": false,
        "properties": {
          "deleted": { "type": "boolean", "const": true },
          "pet_id": { "type": "string", "format": "uuid" },
          "rows_removed": { "type": "object", "additionalProperties": { "type": "integer" } },
          "files_removed": { "type": "integer", "minimum": 0 }
        }
      },
      "PassedAwayResponse": {
        "type": "object",
        "required": ["notification_sent", "pet_id", "notified_count", "delivery_status"],
        "additionalProperties": false,
        "properties": {
          "notification_sent": {
            "type": "boolean",
            "description": "True only when at least one in-app notification row was created (completed delivery)."
          },
          "pet_id": { "type": "string", "format": "uuid" },
          "notified_count": { "type": "integer", "minimum": 0 },
          "delivery_status": {
            "type": "string",
            "enum": ["delivered", "no_recipients"]
          }
        }
      },
      "CareAsOf": {
        "type": "object",
        "required": [
          "date",
          "time",
          "timezone"
        ],
        "additionalProperties": false,
        "description": "Pet home clock the server used (D-CIE-028)",
        "properties": {
          "date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "OpenOccurrence": {
        "type": "object",
        "required": [
          "id",
          "scheduled_date",
          "scheduled_time",
          "status",
          "origin"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scheduled_date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "scheduled_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "oneOf": [
              {
                "const": "coming_up"
              },
              {
                "const": "due"
              },
              {
                "const": "overdue"
              },
              {
                "const": "not_recorded"
              }
            ]
          },
          "origin": {
            "oneOf": [
              {
                "const": "schedule"
              },
              {
                "const": "computed"
              },
              {
                "const": "planned"
              }
            ]
          }
        }
      },
      "CareItem": {
        "type": "object",
        "additionalProperties": true,
        "description": "Care item (health entry) with its real open occurrences (D-CSM-019). Payload stays small: at most the 3-day stack plus the next date per item.",
        "required": [
          "id",
          "pet_id",
          "name",
          "frequency",
          "recurrence_anchor",
          "status",
          "next_due_date",
          "open_occurrences",
          "as_of",
          "estimated_next"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "pet_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "recurrence_anchor": {
            "oneOf": [
              {
                "const": "from_due_date"
              },
              {
                "const": "from_completion"
              }
            ]
          },
          "status": {
            "oneOf": [
              {
                "const": "active"
              },
              {
                "const": "paused"
              },
              {
                "const": "completed"
              }
            ]
          },
          "next_due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_occurrences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpenOccurrence"
            }
          },
          "as_of": {
            "$ref": "#/components/schemas/CareAsOf"
          },
          "estimated_next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "date",
                  "basis"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/components/schemas/CalendarDate"
                  },
                  "basis": {
                    "const": "done_today"
                  }
                }
              }
            ]
          },
          "schedule_anchor_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "late_completion_choice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "const": "keep"
              },
              {
                "const": "skip_next"
              },
              {
                "const": "shift_following"
              }
            ]
          },
          "paused_until": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "resume_default_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CareCommandResponse": {
        "type": "object",
        "required": [
          "entry",
          "next_due_date",
          "undo_token"
        ],
        "additionalProperties": true,
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/CareItem"
          },
          "next_due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "undo_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_choice_applied": {
            "description": "Completions only: the next-date choice applied when done late with a waiting date (sent, remembered, or keep); null when none was needed (D-CSM-026)",
            "enum": [
              "keep",
              "skip_next",
              "shift_following",
              null
            ]
          }
        }
      },
      "CareCommandError": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": true,
        "description": "4xx from a care command; nothing was saved",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": true,
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "OccurrenceDetail": {
        "type": "object",
        "required": [
          "occurrence",
          "entry",
          "last_action"
        ],
        "additionalProperties": false,
        "properties": {
          "occurrence": {
            "type": "object",
            "required": [
              "id",
              "scheduled_date",
              "status",
              "occurrence_status"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "scheduled_date": {
                "$ref": "#/components/schemas/CalendarDate"
              },
              "scheduled_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "completed",
                  "skipped"
                ]
              },
              "occurrence_status": {
                "description": "Open: coming_up, due, overdue, not_recorded. Closed: done, skipped, not_recorded",
                "enum": [
                  "coming_up",
                  "due",
                  "overdue",
                  "not_recorded",
                  "done",
                  "skipped"
                ]
              },
              "completed_on": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CalendarDate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "origin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "close_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "entry": {
            "type": "object",
            "required": [
              "id",
              "pet_id",
              "name",
              "recurrence_anchor",
              "status",
              "as_of"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "pet_id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "care_family": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recurrence_anchor": {
                "enum": [
                  "from_completion",
                  "from_due_date"
                ]
              },
              "late_completion_choice": {
                "enum": [
                  "keep",
                  "skip_next",
                  "shift_following",
                  null
                ]
              },
              "status": {
                "type": "string"
              },
              "as_of": {
                "$ref": "#/components/schemas/CareAsOf"
              }
            }
          },
          "last_action": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "occurrence_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "occurrence_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "linked_weight": {
            "type": "object",
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        }
      },
      "OccurrencePatch": {
        "type": "object",
        "additionalProperties": true,
        "description": "Send completed_on alone, or notes / provider fields",
        "properties": {
          "completed_on": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "notes": {
            "type": "string"
          },
          "provider_contact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_typed_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CompletionDateResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "completed_on",
          "occurrence",
          "entry",
          "next_due_date",
          "undo_token",
          "moved_next_id",
          "next_unchanged"
        ],
        "additionalProperties": true,
        "description": "Occurrence fields at the top level (as for a notes change) plus the care command response",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "completed"
          },
          "completed_on": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "occurrence": {
            "type": "object"
          },
          "entry": {
            "$ref": "#/components/schemas/CareItem"
          },
          "next_due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "undo_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "moved_next_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "After it's done: the computed next date this change re-dated"
          },
          "next_unchanged": {
            "type": "boolean",
            "description": "After it's done: the next date was moved by a person and stays"
          }
        }
      }
    }
  }
}

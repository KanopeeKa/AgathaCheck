{
  "openapi": "3.1.0",
  "info": {
    "title": "Agatha Track — Pet Care critical API subset",
    "version": "1.0.0",
    "description": "Stable DTO contract for pets CRUD, lifecycle, and auth session tokens (F-14). Mounted at /api and /backend/api."
  },
  "servers": [{ "url": "/api" }],
  "paths": {
    "/auth/signup": {
      "post": {
        "operationId": "authSignup",
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "authLogin",
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSessionResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "responses": {
          "200": {
            "description": "Tokens rotated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthTokenPair" }
              }
            }
          }
        }
      }
    },
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "Owned pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "responses": {
          "201": {
            "description": "Pet created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/all": {
      "get": {
        "operationId": "listAllPets",
        "responses": {
          "200": {
            "description": "Owned, shared, foster, and org pets visible to user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "operationId": "getPet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet deleted (data cascade on server)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeletePetResponse" }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/data": {
      "delete": {
        "operationId": "deletePetData",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Pet-related rows and files removed; pet row retained until DELETE /pets/{id}",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PetDataDeleteResponse" }
              }
            }
          }
        }
      }
    },
    "/pets/{id}/passed-away": {
      "post": {
        "operationId": "notifyPassedAway",
        "parameters": [{ "$ref": "#/components/parameters/PetId" }],
        "responses": {
          "200": {
            "description": "Collaborators notified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PassedAwayResponse" }
              }
            }
          }
        }
      }
    },
    "/health-entries/{id}": {
      "get": {
        "operationId": "getCareItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          }
        ],
        "responses": {
          "200": {
            "description": "Care item with open occurrences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareItem"
                }
              }
            }
          }
        }
      }
    },
    "/health-entries/{id}/occurrences/{occId}/complete": {
      "post": {
        "operationId": "completeOccurrence",
        "parameters": [
          {
            "$ref": "#/components/parameters/HealthEntryId"
          },
          {
            "$ref": "#/components/parameters/OccurrenceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Completed; the next date is in entry.open_occurrences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareCommandResponse"
                }
              }
            }
          },
          "409": {
            "description": "A next-date choice is needed (nothing saved)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextChoiceRequired"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "PetId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "HealthEntryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OccurrenceId": {
        "name": "occId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CalendarDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Calendar day on the wire (YYYY-MM-DD)"
      },
      "User": {
        "type": "object",
        "required": ["id", "email"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "category": { "type": "string" },
          "locale": { "type": "string" }
        }
      },
      "AuthTokenPair": {
        "type": "object",
        "required": ["access_token", "refresh_token"],
        "additionalProperties": false,
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "required": ["user", "access_token", "refresh_token"],
        "additionalProperties": false,
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "Pet": {
        "type": "object",
        "required": ["id", "name", "species"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "species": { "type": "string" },
          "breed": { "type": "string" },
          "age": { "type": ["number", "null"] },
          "dateOfBirth": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "date_of_birth": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "weight": { "type": ["number", "null"] },
          "gender": { "type": ["string", "null"] },
          "bio": { "type": "string" },
          "insurance": { "type": "string" },
          "neuteredDate": { "oneOf": [{ "$ref": "#/components/schemas/CalendarDate" }, { "type": "null" }] },
          "neuterDismissed": { "type": "boolean" },
          "chipId": { "type": "string" },
          "chipDismissed": { "type": "boolean" },
          "photoPath": { "type": ["string", "null"] },
          "vetId": { "type": ["string", "null"] },
          "colorValue": { "type": ["integer", "null"] },
          "passedAway": { "type": "boolean" },
          "organization_id": { "type": ["string", "null"], "format": "uuid" },
          "organization_name": { "type": ["string", "null"] },
          "is_shared": { "type": "boolean" },
          "is_foster": { "type": "boolean" },
          "foster_placement_status": { "type": ["string", "null"] },
          "foster_name": { "type": ["string", "null"] },
          "primary_holder_name": { "type": ["string", "null"], "description": "Deprecated alias for pet_parent_name" },
          "pet_parent_name": { "type": ["string", "null"] },
          "access_role": { "type": ["string", "null"], "enum": ["carer", "co_parent", null] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      },
      "DeletePetResponse": {
        "type": "object",
        "required": ["deleted"],
        "additionalProperties": false,
        "properties": {
          "deleted": { "type": "boolean", "const": true }
        }
      },
      "PetDataDeleteResponse": {
        "type": "object",
        "required": ["deleted", "pet_id", "rows_removed", "files_removed"],
        "additionalProperties": false,
        "properties": {
          "deleted": { "type": "boolean", "const": true },
          "pet_id": { "type": "string", "format": "uuid" },
          "rows_removed": { "type": "object", "additionalProperties": { "type": "integer" } },
          "files_removed": { "type": "integer", "minimum": 0 }
        }
      },
      "PassedAwayResponse": {
        "type": "object",
        "required": ["notification_sent", "pet_id", "notified_count", "delivery_status"],
        "additionalProperties": false,
        "properties": {
          "notification_sent": {
            "type": "boolean",
            "description": "True only when at least one in-app notification row was created (completed delivery)."
          },
          "pet_id": { "type": "string", "format": "uuid" },
          "notified_count": { "type": "integer", "minimum": 0 },
          "delivery_status": {
            "type": "string",
            "enum": ["delivered", "no_recipients"]
          }
        }
      },
      "CareAsOf": {
        "type": "object",
        "required": [
          "date",
          "time",
          "timezone"
        ],
        "additionalProperties": false,
        "description": "Pet home clock the server used (D-CIE-028)",
        "properties": {
          "date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "OpenOccurrence": {
        "type": "object",
        "required": [
          "id",
          "scheduled_date",
          "scheduled_time",
          "status",
          "origin"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "scheduled_date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "scheduled_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "oneOf": [
              {
                "const": "coming_up"
              },
              {
                "const": "due"
              },
              {
                "const": "overdue"
              },
              {
                "const": "not_recorded"
              }
            ]
          },
          "origin": {
            "oneOf": [
              {
                "const": "schedule"
              },
              {
                "const": "computed"
              },
              {
                "const": "planned"
              }
            ]
          }
        }
      },
      "CareItem": {
        "type": "object",
        "additionalProperties": true,
        "description": "Care item (health entry) with its real open occurrences (D-CSM-019). Payload stays small: at most the 3-day stack plus the next date per item.",
        "required": [
          "id",
          "pet_id",
          "name",
          "frequency",
          "recurrence_anchor",
          "status",
          "next_due_date",
          "open_occurrences",
          "as_of",
          "estimated_next"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "pet_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "recurrence_anchor": {
            "oneOf": [
              {
                "const": "from_due_date"
              },
              {
                "const": "from_completion"
              }
            ]
          },
          "status": {
            "oneOf": [
              {
                "const": "active"
              },
              {
                "const": "paused"
              },
              {
                "const": "completed"
              }
            ]
          },
          "next_due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_occurrences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpenOccurrence"
            }
          },
          "as_of": {
            "$ref": "#/components/schemas/CareAsOf"
          },
          "estimated_next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "date",
                  "basis"
                ],
                "properties": {
                  "date": {
                    "$ref": "#/components/schemas/CalendarDate"
                  },
                  "basis": {
                    "const": "done_today"
                  }
                }
              }
            ]
          },
          "schedule_anchor_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "late_completion_choice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "const": "keep"
              },
              {
                "const": "skip_next"
              },
              {
                "const": "shift_following"
              }
            ]
          },
          "paused_until": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "resume_default_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CareCommandResponse": {
        "type": "object",
        "required": [
          "entry",
          "next_due_date",
          "undo_token"
        ],
        "additionalProperties": true,
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/CareItem"
          },
          "next_due_date": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CalendarDate"
              },
              {
                "type": "null"
              }
            ]
          },
          "undo_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "NextChoiceRequired": {
        "type": "object",
        "required": [
          "error",
          "code",
          "waiting_occurrence",
          "shift",
          "options"
        ],
        "additionalProperties": false,
        "description": "409 — nothing was saved; re-send with next_choice (D-CSM-026)",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "const": "next_choice_required"
          },
          "waiting_occurrence": {
            "type": "object",
            "required": [
              "id",
              "scheduled_date",
              "scheduled_time",
              "origin"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "scheduled_date": {
                "$ref": "#/components/schemas/CalendarDate"
              },
              "scheduled_time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "origin": {
                "type": "string"
              }
            }
          },
          "shift": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "integer"
              },
              "minutes": {
                "type": "integer"
              }
            }
          },
          "options": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "const": "keep"
                },
                {
                  "const": "skip_next"
                },
                {
                  "const": "shift_following"
                }
              ]
            }
          }
        }
      }
    }
  }
}

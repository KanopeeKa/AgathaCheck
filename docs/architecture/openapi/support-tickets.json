{
  "openapi": "3.1.0",
  "info": {
    "title": "Agatha Track — Support intake API",
    "version": "1.0.0",
    "description": "Support ticket submit contract (phase 3). Mounted at /api/support and /backend/api/support."
  },
  "servers": [{ "url": "/api/support" }],
  "paths": {
    "/tickets": {
      "post": {
        "operationId": "supportSubmitTicket",
        "description": "Create a private support ticket (signed-in optional).",
        "responses": {
          "201": {
            "description": "Ticket accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupportTicketCreatedResponse" }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupportErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid bearer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupportErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "headers": {
              "Retry-After": {
                "schema": { "type": "integer" },
                "description": "Seconds until the client may retry"
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SupportErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SupportTicketCreatedResponse": {
        "type": "object",
        "required": ["reference"],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^AT-[0-9A-HJKMNP-TV-Z]{8}$"
          }
        },
        "additionalProperties": false
      },
      "SupportErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
